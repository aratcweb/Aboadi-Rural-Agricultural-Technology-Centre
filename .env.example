# Environment variables required for local development and production.

# Email Delivery Configuration (e.g., Resend, SendGrid)
# These are used by the server action in app/actions/contact.js to deliver enquiry emails.
EMAIL_PROVIDER_API_KEY="your-api-key-here"
EMAIL_FROM_ADDRESS="noreply@aratc-ghana.org"
EMAIL_TO_ADDRESS="info@aratc-ghana.org"

# Next.js specific variables
NEXT_PUBLIC_SITE_URL="https://arattc.org"
